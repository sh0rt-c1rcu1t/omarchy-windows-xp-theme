#!/usr/bin/env bash
#
# Omarchy startup hook: play the Windows XP startup chime once the session has
# finished booting.
#
# Installed as ~/.config/omarchy/hooks/post-boot.d/windows-xp-startup-sound
# by the theme's install.sh.

set -euo pipefail

THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
SOUND_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sounds/windows-xp/stereo"
SOUND_FILE="$SOUND_DIR/desktop-login.oga"

[ -f "$SOUND_FILE" ] || exit 0

# Only play for this theme: the chime should not follow the user around.
if [ -r "$THEME_NAME_FILE" ]; then
  current=$(cat "$THEME_NAME_FILE")
  case "$current" in
  *windows-xp* | *xp*) ;;
  *) exit 0 ;;
  esac
fi

play_sound() {
  if command -v paplay >/dev/null 2>&1; then
    paplay "$SOUND_FILE" >/dev/null 2>&1 && return 0
  fi
  if command -v pw-play >/dev/null 2>&1; then
    pw-play "$SOUND_FILE" >/dev/null 2>&1 && return 0
  fi
  if command -v mpv >/dev/null 2>&1; then
    mpv --no-video --really-quiet "$SOUND_FILE" >/dev/null 2>&1 && return 0
  fi
  if command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit -loglevel quiet "$SOUND_FILE" >/dev/null 2>&1 && return 0
  fi
  return 1
}

# The session bus and PipeWire need a moment after login; a short delay also
# keeps the chime from competing with the login notification.
( sleep 2; play_sound ) &

exit 0
