{
  // ---------------------------------------------------------------------
  // Windows XP Start menu, as it ships in Windows XP Professional SP3.
  //
  // This file is the single source of truth for both surfaces this theme
  // installs:
  //
  //   1. the XP-style Start menu plugin (plugins/windows-xp.start-menu),
  //      which renders this tree as the classic two-column Start menu
  //   2. the Omarchy menu extension
  //      (extensions/omarchy-menu.jsonc), generated by tools/build.py, so
  //      Super+Space and every other omarchy-menu route speaks XP too.
  //
  // Every row carries an `action` that works on a stock Omarchy install.
  // Absolute paths are used instead of `~`/`$HOME`: the actions are executed
  // through Quickshell.execDetached, which does not expand a leading tilde.
  // ---------------------------------------------------------------------
  "title": "Windows XP",

  // Left column, top block.
  "pinned": [
    {
      "id": "internet",
      "label": "Internet",
      "icon": "internet",
      "action": "omarchy-launch-browser"
    },
    {
      "id": "email",
      "label": "E-mail",
      "icon": "email",
      "action": "omarchy-launch-webapp 'https://mail.google.com'"
    }
  ],

  // Left column: the All Programs fly-out. `provider: "apps"` is filled in by
  // the plugin from the shared application library, exactly like the apps
  // submenu of the Omarchy menu.
  "allPrograms": {
    "id": "all-programs",
    "label": "All Programs",
    "icon": "all-programs",
    "provider": "apps"
  },

  // Left column, bottom block: XP's fixed "recently used" area. These four are
  // what a clean XP install pins below the separator.
  "below": [
    {
      "id": "my-pictures",
      "label": "My Pictures",
      "icon": "my-pictures",
      "action": "omarchy-xp-open-folder xdg:PICTURES"
    },
    {
      "id": "my-music",
      "label": "My Music",
      "icon": "my-music",
      "action": "omarchy-xp-open-folder xdg:MUSIC"
    },
    {
      "id": "my-computer",
      "label": "My Computer",
      "icon": "my-computer",
      "menu": [
        {
          "id": "my-computer.overview",
          "label": "System Tasks",
          "icon": "system-tasks",
          "action": "omarchy-launch-about"
        },
        {
          "id": "my-computer.files",
          "label": "Files Stored on This Computer",
          "icon": "folder-open",
          "action": "omarchy-xp-open-folder home"
        },
        {
          "id": "my-computer.disk",
          "label": "Local Disk (C:)",
          "icon": "hard-drive",
          "action": "omarchy-xp-open-folder root"
        },
        {
          "id": "my-computer.home",
          "label": "Local Disk (D:)",
          "icon": "hard-drive",
          "action": "omarchy-xp-open-folder home"
        },
        {
          "id": "my-computer.removable",
          "label": "Devices with Removable Storage",
          "icon": "removable",
          "action": "omarchy-xp-open-folder removable"
        },
        {
          "id": "my-computer.shared",
          "label": "Shared Documents",
          "icon": "shared-folder",
          "action": "omarchy-xp-open-folder xdg:PUBLIC"
        }
      ]
    },
    {
      "id": "control-panel",
      "label": "Control Panel",
      "icon": "control-panel",
      "menu": [
        {
          "id": "control-panel.appearance",
          "label": "Appearance and Themes",
          "icon": "appearance",
          "menu": [
            {
              "id": "control-panel.appearance.theme",
              "label": "Change the computer's theme",
              "icon": "appearance",
              "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\""
            },
            {
              "id": "control-panel.appearance.background",
              "label": "Change the desktop background",
              "icon": "appearance",
              "action": "background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\""
            },
            {
              "id": "control-panel.appearance.font",
              "label": "Change the system font",
              "icon": "appearance",
              "action": "omarchy-menu summon style.font"
            }
          ]
        },
        {
          "id": "control-panel.display",
          "label": "Display",
          "icon": "display",
          "action": "omarchy-launch-config-editor @HOME@/.config/hypr/monitors.lua"
        },
        {
          "id": "control-panel.sound",
          "label": "Sounds and Audio Devices",
          "icon": "sound",
          "action": "omarchy-shell shell summon omarchy.audio"
        },
        {
          "id": "control-panel.network",
          "label": "Network Connections",
          "icon": "network",
          "action": "omarchy-shell shell summon omarchy.network"
        },
        {
          "id": "control-panel.printers",
          "label": "Printers and Faxes",
          "icon": "printer",
          "action": "omarchy-launch-config-editor @HOME@/.config/omarchy/shell.json"
        },
        {
          "id": "control-panel.power",
          "label": "Power Options",
          "icon": "power",
          "action": "omarchy-shell shell summon omarchy.power"
        },
        {
          "id": "control-panel.keyboard",
          "label": "Keyboard",
          "icon": "keyboard",
          "action": "omarchy-launch-config-editor @HOME@/.config/hypr/input.lua"
        },
        {
          "id": "control-panel.users",
          "label": "User Accounts",
          "icon": "users",
          "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-passwordless-sudo"
        },
        {
          "id": "control-panel.add-remove",
          "label": "Add or Remove Programs",
          "icon": "add-remove",
          "action": "xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-install"
        },
        {
          "id": "control-panel.system",
          "label": "System",
          "icon": "system",
          "action": "omarchy-launch-floating-terminal-with-presentation omarchy-about"
        }
      ]
    },
    {
      "id": "help-support",
      "label": "Help and Support",
      "icon": "help",
      "action": "omarchy-launch-webapp 'https://manuals.omarchy.org/'"
    },
    {
      "id": "search",
      "label": "Search",
      "icon": "search",
      "action": "omarchy-shell shell summon omarchy.launcher"
    },
    {
      "id": "run",
      "label": "Run...",
      "icon": "run",
      "action": "omarchy-launch-floating-terminal-with-presentation omarchy-launch-shell"
    }
  ],

  // Right column: the white quick-link block of the XP Start menu.
  "right": [
    {
      "id": "right.my-documents",
      "label": "My Documents",
      "icon": "my-documents",
      "bold": true,
      "action": "omarchy-xp-open-folder xdg:DOCUMENTS"
    },
    {
      "id": "right.recent",
      "label": "My Recent Documents",
      "icon": "recent",
      "action": "omarchy-launch-floating-terminal-with-presentation omarchy-menu-share clipboard"
    },
    {
      "id": "right.pictures",
      "label": "My Pictures",
      "icon": "my-pictures",
      "action": "omarchy-xp-open-folder xdg:PICTURES"
    },
    {
      "id": "right.music",
      "label": "My Music",
      "icon": "my-music",
      "action": "omarchy-xp-open-folder xdg:MUSIC"
    },
    {
      "id": "right.computer",
      "label": "My Computer",
      "icon": "my-computer",
      "bold": true,
      "action": "omarchy-xp-open-folder root"
    },
    {
      "id": "right.network-places",
      "label": "My Network Places",
      "icon": "network-places",
      "menu": [
        {
          "id": "right.network-places.wifi",
          "label": "Wireless Network Connection",
          "icon": "network",
          "action": "omarchy-shell shell summon omarchy.network"
        },
        {
          "id": "right.network-places.bluetooth",
          "label": "Bluetooth Devices",
          "icon": "network",
          "action": "omarchy-shell shell summon omarchy.bluetooth"
        },
        {
          "id": "right.network-places.tailscale",
          "label": "Tailscale Machines",
          "icon": "network",
          "action": "omarchy-shell shell summon omarchy.tailscale"
        },
        {
          "id": "right.network-places.localsend",
          "label": "LocalSend",
          "icon": "network",
          "action": "uwsm-app -- localsend"
        }
      ]
    },
    {
      "id": "right.control-panel",
      "label": "Control Panel",
      "icon": "control-panel",
      "target": "control-panel"
    },
    {
      "id": "right.settings",
      "label": "Set Program Access and Defaults",
      "icon": "settings",
      "action": "omarchy-menu summon setup.default"
    },
    {
      "id": "right.printers",
      "label": "Printers and Faxes",
      "icon": "printer",
      "action": "omarchy-launch-config-editor @HOME@/.config/omarchy/shell.json"
    },
    {
      "id": "right.help",
      "label": "Help and Support",
      "icon": "help",
      "action": "omarchy-launch-webapp 'https://manuals.omarchy.org/'"
    },
    {
      "id": "right.search",
      "label": "Search",
      "icon": "search",
      "action": "omarchy-shell shell summon omarchy.launcher"
    },
    {
      "id": "right.run",
      "label": "Run...",
      "icon": "run",
      "action": "omarchy-launch-floating-terminal-with-presentation omarchy-launch-shell"
    }
  ],

  // Bottom bar. "Turn Off Computer" opens XP's three-button power dialog,
  // which the Start menu plugin renders itself.
  "footer": [
    {
      "id": "log-off",
      "label": "Log Off",
      "icon": "log-off",
      "action": "omarchy-system-logout"
    },
    {
      "id": "turn-off",
      "label": "Turn Off Computer",
      "icon": "turn-off",
      "dialog": "power"
    }
  ],

  "powerDialog": {
    "title": "Turn off computer",
    "buttons": [
      {
        "id": "stand-by",
        "label": "Stand By",
        "icon": "power-standby",
        "action": "systemctl suspend"
      },
      {
        "id": "turn-off",
        "label": "Turn Off",
        "icon": "power-off",
        "action": "omarchy-system-shutdown"
      },
      {
        "id": "restart",
        "label": "Restart",
        "icon": "power-restart",
        "action": "omarchy-system-reboot"
      }
    ]
  }
}
