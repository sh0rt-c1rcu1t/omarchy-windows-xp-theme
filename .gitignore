# Generated theme artifacts that should never be committed.
__pycache__/
*.pyc
*.tmp
*.bak
*.bak.*
.DS_Store

# Scratch output from the generator tools.
/tmp/
/out/

# The genuine Bliss photograph is Charles O'Rear's copyright, licensed to
# Microsoft, and is the only file here that is not original work. It is kept out
# of version control so that cloning and publishing this repository never
# carries it.
#
# backgrounds/1-bliss.jpg is the tracked stand-in: the theme-set hook falls back
# to it, so a fresh clone still gets a sharp wallpaper, and
# scripts/install-wallpaper.sh puts the real photograph here at full quality.
#
# Delete this line if you have decided you are happy to publish the photograph.
backgrounds/0-bliss-original.png
